OSI_APP_HOST=0.0.0.0
OSI_APP_PORT=8011

OSI_REDIS_URL=redis://localhost:6379/0
OSI_POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/osi

OSI_MIN_SIGNAL_CONFIDENCE=45
OSI_SIGNAL_MODE=multi_strategy
OSI_STRATEGY_CONFIDENCE_FLOOR=35
OSI_STRATEGY_FALLBACK_ENABLED=true
OSI_SCALPING_ENTRY_MODE=aggressive
OSI_OPTION_DATA_STALE_SEC=2.0
OSI_INSTRUMENT_MAX_AGE_HOURS=24
OSI_TARGET_MULTIPLIER=1.4
OSI_SL_MULTIPLIER=0.8

OSI_ANGEL_API_KEY=your_api_key
OSI_ANGEL_CLIENT_ID=your_client_id
OSI_ANGEL_PASSWORD=your_password
OSI_ANGEL_TOTP_SECRET=your_totp_secret
OSI_ANGEL_FEED_TOKEN=

OSI_HOLIDAYS_CSV=2026-01-26,2026-03-06,2026-08-15
OSI_WS_RECONNECT_MAX_BACKOFF_SEC=60

# --- Signal gate controls ---------------------------------------------------
# Master switch for the daily-loss + consecutive-SL risk gates.
# Set to false to ignore the caps below (useful for aggressive-signal mode).
OSI_RISK_GATES_ENABLED=true
OSI_DAILY_LOSS_CAP=3000
OSI_MAX_CONSECUTIVE_SL=3

# Allow same-direction re-entries while a position is still open and bypass
# flip-protection / flip-flop guard / max-active gates. Set to true if you
# want every confident consensus to fire regardless of an existing position.
OSI_ALLOW_DUPLICATE_ACTIVE=false
OSI_MAX_ACTIVE_PER_SYMBOL=1
OSI_COOLDOWN_SECONDS=120
OSI_FLIP_FLOP_SECONDS=150
OSI_FLIP_FLOP_CONF_GAP=12

# --- Telegram ---------------------------------------------------------------
OSI_TELEGRAM_ENABLED=false
OSI_TELEGRAM_BOT_TOKEN=
OSI_TELEGRAM_CHAT_ID=
OSI_TELEGRAM_LIVE_LTP_ENABLED=true
OSI_TELEGRAM_LIVE_LTP_INTERVAL_SEC=30
